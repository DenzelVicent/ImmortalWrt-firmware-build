# ============================================================
# 构建系统
# ============================================================

# ---------- 已启用 ----------

# 下载 TLS 证书验证
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
# 构建系统 IPv6 支持
CONFIG_IPV6=y
# JSON 镜像概要信息
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# mold 高速链接器
CONFIG_MOLD=y
# 常规 PIE/ASLR 地址随机化
CONFIG_PKG_ASLR_PIE_REGULAR=y
# 常规栈溢出保护
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
# 格式化字符串安全检查
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
# DT_RELR 相对重定位压缩
CONFIG_PKG_DT_RELR=y
# _FORTIFY_SOURCE 级别 1
CONFIG_PKG_FORTIFY_SOURCE_1=y
# 完整 RELRO 只读重定位
CONFIG_PKG_RELRO_FULL=y
# Shadow 密码文件
CONFIG_SHADOW_PASSWORDS=y
# 软件包签名验证
CONFIG_SIGNATURE_CHECK=y
# 软件包签名
CONFIG_SIGNED_PACKAGES=y
# 逐包签名
CONFIG_SIGN_EACH_PACKAGE=y
# 固件镜像签名
CONFIG_SIGN_FIRMWARE=y
# sstrip 丢弃尾部零
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y
# APK 软件包管理器
CONFIG_USE_APK=y
# 文件系统 ACL 和属性支持
CONFIG_USE_FS_ACL_ATTR=y
# seccomp 系统调用过滤
CONFIG_USE_SECCOMP=y
# sstrip 二进制裁剪
CONFIG_USE_SSTRIP=y

# ---------- 未启用 ----------

# 未启用: 编译所有包
# CONFIG_ALL is not set
# 未启用: 编译所有内核模块
# CONFIG_ALL_KMODS is not set
