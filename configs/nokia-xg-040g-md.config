# ============================================================
# 软件包 - 网络与防火墙
# ============================================================

# ---------- 已启用 ----------

# 安装 ethtool-full 软件包 (完整网卡诊断调优工具)
CONFIG_PACKAGE_ethtool-full=y
# 安装 iperf3 软件包 (网络性能带宽测试)
CONFIG_PACKAGE_iperf3=y
# 安装 iw 软件包 (nl80211 无线配置工具)
CONFIG_PACKAGE_iw=m
# 安装 odhcp6c 软件包 (ODHCP DHCPv6 客户端)
CONFIG_PACKAGE_odhcp6c=y
# 安装 odhcpd-ipv6only 软件包 (ODHCP IPv6 DHCP/RA 服务器)
CONFIG_PACKAGE_odhcpd-ipv6only=y
# 安装 ppp 软件包 (PPP 点对点协议)
CONFIG_PACKAGE_ppp=y
# 安装 ppp-mod-pppoe 软件包 (PPPoE 拨号模块)
CONFIG_PACKAGE_ppp-mod-pppoe=y
# 安装 tcpdump 软件包 (命令行网络抓包分析器)
CONFIG_PACKAGE_tcpdump=y
# 安装 uclient-fetch 软件包 (轻量 HTTP/HTTPS 下载工具)
CONFIG_PACKAGE_uclient-fetch=y

