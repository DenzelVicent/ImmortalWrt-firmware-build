# ============================================================
# MTK WiFi 驱动
# ============================================================

# ---------- 已启用 ----------

# 安装 kmod-mt76-core 软件包 (MT76 通用 WiFi 驱动核心)
CONFIG_PACKAGE_kmod-mt76-core=m
# 安装 kmod-mt7915e 软件包 (MT7915E WiFi 6/6E 驱动)
CONFIG_PACKAGE_kmod-mt7915e=m
# 安装 kmod-mt7916-firmware 软件包 (MT7916 WiFi 固件)
CONFIG_PACKAGE_kmod-mt7916-firmware=m

# ---------- 未启用 ----------

# ============================================================
# 网络连接基础设施与 WARP 加速
# ============================================================

# ============================================================
# 加密与 SSL
# ============================================================

# ---------- 已启用 ----------

# 安装 libopenssl 软件包 (OpenSSL 加密通信库)
CONFIG_PACKAGE_libopenssl=y
# 安装 libopenssl-conf 软件包 (OpenSSL 引擎配置文件)
CONFIG_PACKAGE_libopenssl-conf=m
# 安装 libopenssl-legacy 软件包 (OpenSSL 旧版算法支持)
CONFIG_PACKAGE_libopenssl-legacy=m
# OpenSSL 引擎支持
CONFIG_OPENSSL_ENGINE=y
# OpenSSL 性能优化
CONFIG_OPENSSL_OPTIMIZE_SPEED=y
# OpenSSL 首选 ChaCha20
CONFIG_OPENSSL_PREFER_CHACHA_OVER_GCM=y
# OpenSSL 汇编加速
CONFIG_OPENSSL_WITH_ASM=y
# OpenSSL ChaCha20-Poly1305
CONFIG_OPENSSL_WITH_CHACHA_POLY1305=y
# OpenSSL CMS
CONFIG_OPENSSL_WITH_CMS=y
# OpenSSL 旧版 API
CONFIG_OPENSSL_WITH_DEPRECATED=y
# OpenSSL 错误消息
CONFIG_OPENSSL_WITH_ERROR_MESSAGES=y
# OpenSSL IDEA 算法
CONFIG_OPENSSL_WITH_IDEA=y
# OpenSSL MDC2
CONFIG_OPENSSL_WITH_MDC2=y
# OpenSSL 预共享密钥
CONFIG_OPENSSL_WITH_PSK=y
# OpenSSL SEED 算法
CONFIG_OPENSSL_WITH_SEED=y
# OpenSSL SRP 认证
CONFIG_OPENSSL_WITH_SRP=y
# OpenSSL TLS 1.3
CONFIG_OPENSSL_WITH_TLS13=y
# OpenSSL WHIRLPOOL
CONFIG_OPENSSL_WITH_WHIRLPOOL=y
# wolfSSL 备用名称
CONFIG_WOLFSSL_ALT_NAMES=y
# wolfSSL AES-CCM
CONFIG_WOLFSSL_HAS_AES_CCM=y
# wolfSSL ARC4
CONFIG_WOLFSSL_HAS_ARC4=y
# wolfSSL 证书生成
CONFIG_WOLFSSL_HAS_CERTGEN=y
# wolfSSL ChaCha20-Poly1305
CONFIG_WOLFSSL_HAS_CHACHA_POLY=y
# wolfSSL DH 密钥交换
CONFIG_WOLFSSL_HAS_DH=y
# wolfSSL Ed25519
CONFIG_WOLFSSL_HAS_ECC25519=y
# wolfSSL OCSP
CONFIG_WOLFSSL_HAS_OCSP=y
# wolfSSL OpenVPN
CONFIG_WOLFSSL_HAS_OPENVPN=y
# wolfSSL 会话票据
CONFIG_WOLFSSL_HAS_SESSION_TICKET=y
# wolfSSL TLS 1.0
CONFIG_WOLFSSL_HAS_TLSV10=y
# wolfSSL TLS 1.3
CONFIG_WOLFSSL_HAS_TLSV13=y
# wolfSSL WPA
CONFIG_WOLFSSL_HAS_WPAS=y

# ---------- 未启用 ----------

# 未启用: OpenSSL 内置引擎
# CONFIG_OPENSSL_ENGINE_BUILTIN is not set
# 未启用: OpenSSL 内核 TLS 加速
# CONFIG_OPENSSL_KTLS is not set
# 未启用: OpenSSL 禁用旧版 API
# CONFIG_OPENSSL_NO_DEPRECATED is not set
# 未启用: OpenSSL ARIA 算法
# CONFIG_OPENSSL_WITH_ARIA is not set
# 未启用: OpenSSL BLAKE2
# CONFIG_OPENSSL_WITH_BLAKE2 is not set
# 未启用: OpenSSL Camellia 算法
# CONFIG_OPENSSL_WITH_CAMELLIA is not set
# 未启用: OpenSSL 压缩
# CONFIG_OPENSSL_WITH_COMPRESSION is not set
# 未启用: OpenSSL DTLS
# CONFIG_OPENSSL_WITH_DTLS is not set
# 未启用: OpenSSL EC2M 曲线
# CONFIG_OPENSSL_WITH_EC2M is not set
# 未启用: OpenSSL NPN 扩展
# CONFIG_OPENSSL_WITH_NPN is not set
# 未启用: OpenSSL RFC3779
# CONFIG_OPENSSL_WITH_RFC3779 is not set
# 未启用: OpenSSL 国密 SM2/3/4
# CONFIG_OPENSSL_WITH_SM234 is not set
# 未启用: wolfSSL DTLS
# CONFIG_WOLFSSL_HAS_DTLS is not set
# 未启用: wolfSSL Ed448
# CONFIG_WOLFSSL_HAS_ECC448 is not set

