# 安装 jansson 软件包 (Jansson JSON 编解码库)
CONFIG_PACKAGE_jansson=y
# 安装 libblobmsg-json 软件包 (blobmsg JSON 序列化库)
CONFIG_PACKAGE_libblobmsg-json=y
# 安装 libbpf 软件包 (Linux BPF 用户态库)
CONFIG_PACKAGE_libbpf=y
# 安装 libelf 软件包 (ELF 文件解析库)
CONFIG_PACKAGE_libelf=y
# 安装 libgmp 软件包 (GMP 高精度算术库)
CONFIG_PACKAGE_libgmp=y
# 安装 libi2c 软件包 (I2C 总线访问库)
CONFIG_PACKAGE_libi2c=m
# 安装 libiperf3 软件包 (iperf3 测速核心库)
CONFIG_PACKAGE_libiperf3=y
# 安装 libiwinfo 软件包 (无线设备信息查询库)
CONFIG_PACKAGE_libiwinfo=y
# 安装 libjson-c 软件包 (JSON-C 编解码库)
CONFIG_PACKAGE_libjson-c=y
# 安装 liblucihttp 软件包 (LuCI HTTP 请求解析库)
CONFIG_PACKAGE_liblucihttp=y
# 安装 liblucihttp-ucode 软件包 (LuCI HTTP ucode 绑定)
CONFIG_PACKAGE_liblucihttp-ucode=y
# 安装 libmnl 软件包 (最小化 Netlink 套接字库)
CONFIG_PACKAGE_libmnl=y
# 安装 libnetfilter-conntrack 软件包 (Netfilter 连接跟踪库)
CONFIG_PACKAGE_libnetfilter-conntrack=y
# 安装 libnetfilter-cthelper 软件包 (Netfilter 连接跟踪助手库)
CONFIG_PACKAGE_libnetfilter-cthelper=y
# 安装 libnetfilter-cttimeout 软件包 (Netfilter 连接跟踪超时库)
CONFIG_PACKAGE_libnetfilter-cttimeout=y
# 安装 libnetfilter-queue 软件包 (Netfilter 用户态队列库)
CONFIG_PACKAGE_libnetfilter-queue=y
# 安装 libnettle 软件包 (Nettle 底层加密库)
CONFIG_PACKAGE_libnettle=y
# 安装 libnfnetlink 软件包 (Netfilter Netlink 通信库)
CONFIG_PACKAGE_libnfnetlink=y
# 安装 libnftnl 软件包 (nftables 用户态配置库)
CONFIG_PACKAGE_libnftnl=y
# 安装 libnl-tiny 软件包 (轻量 Netlink 套接字库)
CONFIG_PACKAGE_libnl-tiny=y
# 安装 libpcap 软件包 (网络数据包捕获库)
CONFIG_PACKAGE_libpcap=y
# 安装 libpcre2 软件包 (PCRE2 正则表达式库)
CONFIG_PACKAGE_libpcre2=y
# 安装 libubox 软件包 (OpenWrt 基础工具库)
CONFIG_PACKAGE_libubox=y
# 安装 libubus 软件包 (OpenWrt ubus 客户端库)
CONFIG_PACKAGE_libubus=y
# 安装 libuci 软件包 (统一配置接口 C 库)
CONFIG_PACKAGE_libuci=y
# 安装 libuclient 软件包 (HTTP/HTTPS 客户端库)
CONFIG_PACKAGE_libuclient=y
# 安装 libucode 软件包 (ucode 脚本引擎库)
CONFIG_PACKAGE_libucode=y
# 安装 libudebug 软件包 (ucode 调试支持库)
CONFIG_PACKAGE_libudebug=y
# 安装 libustream-openssl 软件包 (uStream OpenSSL TLS 后端)
CONFIG_PACKAGE_libustream-openssl=y
# 安装 rpcd-mod-luci 软件包 (rpcd LuCI 扩展模块)
CONFIG_PACKAGE_rpcd-mod-luci=y
# 安装 rpcd-mod-rrdns 软件包 (rpcd 反向 DNS 查询模块)
CONFIG_PACKAGE_rpcd-mod-rrdns=y
# 安装 zlib 软件包 (zlib 压缩解压库)
CONFIG_PACKAGE_zlib=y
# PCRE2_JIT_ENABLED
CONFIG_PCRE2_JIT_ENABLED=y

